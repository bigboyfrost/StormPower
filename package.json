{
  "name": "stormpower",
  "productName": "StormPower",
  "version": "1.5.9",
  "description": "StormPower - external spawn overlay for Stormworks. By Aimless Developement.",
  "author": "Aimless Developement",
  "license": "MIT",
  "main": "companion/main.js",
  "scripts": {
    "start": "electron .",
    "update": "electron . --update-ui",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always",
    "make-icon": "node scripts/make-icon.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bigboyfrost/StormPower.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "node-global-key-listener": "^0.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.aimless.stormpower",
    "productName": "StormPower",
    "copyright": "Copyright Aimless Developement",
    "afterPack": "./build/afterPack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "companion/**/*",
      "VERSION",
      "CHANGELOG.md",
      "update-config.json",
      "package.json",
      "!companion/user-settings.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "addon",
        "to": "addon",
        "filter": ["**/*"]
      },
      {
        "from": "engine-mod",
        "to": "engine-mod",
        "filter": ["**/*"]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "StormPower-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StormPower",
      "uninstallDisplayName": "StormPower",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bigboyfrost",
        "repo": "StormPower"
      }
    ]
  }
}
